{"op":"group","id":"steps","scene":"thesis","y":"72%","layout":{"kind":"row","gap":20},"cascade":{"fx":"pop","at":"3b","stagger":"1b","sfx":"pop"},"out":{"fx":"fade","at":"7b","dur":"0.5b"}}
