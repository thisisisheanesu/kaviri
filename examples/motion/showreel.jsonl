# kaviri introduces itself: a 32 second showreel, 16 bars at 120bpm, one scene every two bars.
#   kaviri motion --script examples/motion/showreel.jsonl --out showreel.mp4
{"op":"video","size":[1920,1080],"fps":30,"bpm":120,"grain":0.05,"vignette":0.6,"pulse":0.014}
{"op":"theme","bg":"#0b0b0c","surface":"#141415","surface2":"#1b1b1d","accent":"#ff6b3d","accent2":"#ff9a6b","text":"#f5f4f2","text2":"#cfcdc8","muted":"#8f8d88","faint":"#5f5d59"}
{"op":"music","key":"F#m","progression":["i","VI","III","VII"],"sections":[{"bars":2,"part":"intro"},{"bars":2,"part":"build"},{"bars":8,"part":"drop"},{"bars":2,"part":"break"},{"bars":2,"part":"outro"}]}
{"op":"background","kind":"nebula","base":"#0b0b0c","colors":["#3b1408","#1d1d24","#2a1208"],"stars":90,"intensity":0.7}

# 1. Write the script. The JSONL types itself in, the camera leans in.
