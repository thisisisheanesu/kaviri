{"op":"text","id":"s1t","scene":"script","text":"Write the script.","size":44,"weight":600,"color":"#8f8d88","y":"22%","in":{"fx":"wave","at":"0.5b","dur":"1b"},"out":{"fx":"blur","at":"6.5b","dur":"1b"}}
{"op":"ui","id":"jsonl","scene":"script","kind":"code","title":"demo.jsonl","lang":"json","size":24,"w":1180,"y":"56%","ry":-14,"rx":6,"keys":[{"t":"7b","ry":0,"rx":0,"ease":"inOutCubic"}],"code":"{\"op\":\"navigate\",\"url\":\"http://localhost:3000\"}\n{\"op\":\"click\",\"selector\":\"#new-invoice\"}\n{\"op\":\"type\",\"selector\":\"#amount\",\"text\":\"1450.00\"}\n{\"op\":\"click\",\"selector\":\"#save\"}\n{\"op\":\"wait\",\"ms\":1600}","in":{"fx":"fly","at":"0b","dur":"1.5b"},"out":{"fx":"zoom","at":"7b","dur":"1b"}}
{"op":"act","target":"jsonl","do":"type","at":"1b","dur":"5b"}

# 2. The thesis, on the build: riser, snare roll, hyperspace, flash into the drop.
