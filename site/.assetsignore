# Uploaded assets are public. These are the files that live in this directory for wrangler's
# sake, not the browser's. worker.js refuses them at request time as well, so this is the belt
# and the braces both.
worker.js
wrangler.toml
.assetsignore

# The deploy notes are for whoever runs the deploy, not for the open internet.
README.md

# wrangler writes its build scratch here, including a source map for worker.js. Uploading
# that would publish the Worker source the rest of this file exists to keep out.
.wrangler/

# The Worker's own modules. wrangler bundles them into the script; serving them as
# assets as well would publish the admin's session logic next to the page it protects.
wsrc/

# The docs generator runs before a deploy. The pages it writes are published; it is not.
build-docs.py
